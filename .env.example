MONGO_ROOT_USERNAME=change-this-username
MONGO_ROOT_PASSWORD=change-this-mongodb-password

MONGODB_URI=mongodb://change-this-username:change-this-mongodb-password@localhost:27018/demo1_db?authSource=admin

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

UPLOAD_DIR=uploads
PORT=8080

# SMTP settings for replying from the admin panel
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-or-app-password
MAIL_FROM=your-email@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# GeoIP country detection
# Create a free MaxMind GeoLite account, then add the account ID and license key.
GEOIP_ENABLED=true
GEOIP_DATABASE_PATH=/app/geoip/GeoLite2-Country.mmdb
TRUST_PROXY_HEADERS=false
FORWARD_HEADERS_STRATEGY=none
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOIPUPDATE_FREQUENCY=72
